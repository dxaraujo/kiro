          "git status*",
          "git diff*",
          "git log*",
          "git show*",
          "git grep*",
          "git ls-files*",
          "git ls-tree*",
          "git rev-parse*",
          "git branch",
          "git branch --show-current",
          "git branch --list*",
          "git branch -a*",
          "git branch -r*",
          "git branch -v*",
          "git worktree list*",
          "git for-each-ref*",
          "git config user.name",
          "git config user.email",
          "cd .kiro/local/wt/*",
          "git add *",
          "git commit *",
          "git fetch*",
          "git worktree add .kiro/local/wt/*",
          "uuidgen*",
          "git pull --ff-only*",
          "git switch *"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "git -C *",
          "git -c *",
          "*git merge*",
          "*git rebase*",
          "*git pull*--rebase*",
          "*git reset --hard*",
          "*git clean*",
          "*git checkout -- *",
          "*git checkout .*",
          "*git restore *",
          "*git stash*",
          "*git worktree remove*",
          "*git branch*-D*",
          "*git branch*-M*",
          "*git difftool*",
          "*git grep*-O*",
          "*--open-files-in-pager*",
          "*git *--no-index*",
          "*git *--output*",
          "*--upload-pack*",
          "*--receive-pack*",
          "*--force*",
          "*--delete*",
          "*--no-verify*",
          "*git add* -f*",
          "*git switch* -f*",
          "*--discard-changes*",
          "*gh pr merge*",
          "*glab mr merge*",
          "*rm -rf*",
          "*rm -fr*",
          "*find *-exec*",
          "*find *-ok*",
          "*find *-delete*",
          "*rg *--pre*",
          "*git push* -f*",
          "*git push* +*",
          "*git push* :*",
          "*git push*--mirror*",
          "*git push*--all*",
          "*git push*--prune*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "git push *",
          "gh pr create*",
          "glab mr create*"
        ],
        "effect": "ask"
      },
      {
        "capability": "fs_read",
        "match": [
          "./**",
          "{{POWER}}/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "match": [
          "**/.env",
          "**/.env/**",
          "**/.env.*",
          "**/.env.*/**",
          "**/*.pem",
          "**/*.pem/**",
          "**/*.key",
          "**/*.key/**",
          "~/.ssh/**",
          "~/.aws/**",
          "~/.config/mcp-elm/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          ".kiro/local/loop-*.md",
          ".kiro/specs/**",
          ".kiro/local/wt/*/.kiro/specs/**",
          ".kiro/local/wt/*/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          ".kiro/local/wt/*/.kiro/agents/**",
          ".kiro/local/wt/*/.kiro/hooks/**",
          ".kiro/local/wt/*/.kiro/workflows/**",
          ".kiro/local/wt/*/.kiro/steering/**",
          ".kiro/local/wt/*/.kiro/sdd/**",
          ".kiro/local/wt/*/{{PRODUTO}}/**",
          "**/.git/**",
          "**/.git"
        ],
        "effect": "deny"
      },
      {
        "capability": "subagent",
        "match": [
          "sdd-codificador",
          "sdd-pesquisador",
          "sdd-revisor",
          "sdd-verificador"
        ],
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ],
    "policies": [
      "read-only-shell"
    ]
  }
}
