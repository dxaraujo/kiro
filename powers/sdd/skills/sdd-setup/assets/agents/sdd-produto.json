      "availableAgents": [
        "sdd-pesquisador",
        "sdd-revisor"
      ],
      "trustedAgents": [
        "sdd-pesquisador",
        "sdd-revisor"
      ]
    }
  },
  "includeMcpJson": false,
  "includePowers": true,
  "welcomeMessage": "Vamos trabalhar em quê? (nova demanda, PRD, fatiar, planejar a sprint, review, virada, atendimento, consolidar uma fatia mergeada)",
