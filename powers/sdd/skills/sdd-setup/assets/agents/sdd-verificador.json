        "**/.env.*",
        "**/*.pem",
        "**/*.key",
        "~/.ssh/**",
        "~/.aws/**",
        "~/.config/mcp-elm/**",
        "~/.config/mcp-gitlabpr/**",
        "{{BUNDLE}}/**"
      ]
    },
