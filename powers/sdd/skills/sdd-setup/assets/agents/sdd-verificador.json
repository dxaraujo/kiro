          "git log*",
          "git show*",
          "git grep*",
          "git ls-files*",
          "git ls-tree*",
          "git rev-parse*",
          "git branch",
          "git branch --show-current",
          "git branch --list*",
          "git branch -a*",
          "git branch -r*",
          "git branch -v*",
          "git worktree list*",
          "git for-each-ref*",
          "git config user.name",
          "git config user.email",
          "cd .kiro/local/wt/*",
          "sh .kiro/sdd/http.sh *"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "git -C *",
          "git -c *",
          "*git merge*",
          "*git rebase*",
          "*git pull*--rebase*",
          "*git reset --hard*",
          "*git clean*",
          "*git checkout -- *",
          "*git checkout .*",
          "*git restore *",
          "*git stash*",
          "*git worktree remove*",
          "*git branch*-D*",
          "*git branch*-M*",
          "*git difftool*",
          "*git grep*-O*",
          "*--open-files-in-pager*",
          "*git *--no-index*",
          "*git *--output*",
          "*--upload-pack*",
          "*--receive-pack*",
          "*--force*",
          "*--delete*",
          "*--no-verify*",
          "*git add* -f*",
          "*git switch* -f*",
          "*--discard-changes*",
          "*gh pr merge*",
          "*glab mr merge*",
          "*rm -rf*",
          "*rm -fr*",
          "*find *-exec*",
          "*find *-ok*",
          "*find *-delete*",
          "*rg *--pre*",
          "*git push*",
          "*git add*",
          "*git commit*",
          "*git switch*",
          "*git worktree add*"
