          "*git merge*",
          "*git rebase*",
          "*git reset --hard*",
          "*git clean*",
          "*git checkout -- *",
          "*git restore *",
          "*git stash*",
          "*git worktree remove*",
          "*rm -rf*",
          "*-delete*",
          "*-exec rm*"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          ".kiro/local/wf/**",
          ".kiro/agents/**",
          ".kiro/hooks/**",
          ".kiro/workflows/**",
          ".kiro/steering/**",
          ".kiro/settings/**",
          ".kiro/produto/**",
          ".kiro/local/wt/*/.kiro/agents/**",
          ".kiro/local/wt/*/.kiro/hooks/**",
          ".kiro/local/wt/*/.kiro/workflows/**",
          ".kiro/local/wt/*/.kiro/steering/**",
