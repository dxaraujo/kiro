          "git diff*",
          "git log*",
          "git show*",
          "git grep*",
          "git ls-files*",
          "git ls-tree*",
          "git branch*",
          "git add *",
          "git commit *",
          "git fetch*",
          "git pull --ff-only*",
          "git -C .kiro/local/wt/* status*",
          "git -C .kiro/local/wt/* diff*",
          "git -C .kiro/local/wt/* log*",
          "git -C .kiro/local/wt/* show*",
          "git -C .kiro/local/wt/* grep*",
          "git -C .kiro/local/wt/* add *",
          "git -C .kiro/local/wt/* commit *",
          "git -C .kiro/local/wt/* fetch*",
          "ls*",
          "find * -name *",
          "find * -type *",
          "grep *",
          "rg *",
          "cat *",
          "head *",
          "tail *",
          "wc *",
          "uuidgen*",
          "cd .kiro/local/wt/*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
