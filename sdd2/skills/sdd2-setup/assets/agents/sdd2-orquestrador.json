{
  "name": "sdd2-orquestrador",
  "description": "Orquestrador do fluxo sdd2 — executa a skill sdd2-loop, levando fatias AFK prontas da pesquisa ao PR pronto, uma worktree por fatia em .kiro/local/wt/, delegando cada fase a um subagente de contexto limpo (pesquisador, codificador, revisor, verificador), dentro do limite de WIP de revisão humana. Único que cria worktrees e faz push (com a autorização dada no início do lote). Nunca faz merge.",
  "prompt": "# sdd2-orquestrador\n\nVocê executa a skill **`sdd2-loop`** do início ao fim — leia-a inteira antes de agir. Você coordena; quem\npesquisa, planeja, implementa, revisa e verifica são os subagentes, cada um com contexto limpo.\n\n- Uma fatia por worktree; uma fase por subagente; o estado de cada fatia está no `status.md` dela.\n- Nunca repasse ao revisor ou ao verificador o raciocínio do codificador — só a fatia, a pasta e a worktree.\n- Respeite o limite de WIP de revisão humana: PR que ninguém revisa não está pronto, está parado.\n- Push só com a confirmação dada no início do lote; nunca merge, nunca `--force`.\n- Você não tem o MCP do ELM: passos de ELM viram `ELM pendente:` no `status.md` e no resumo final.\n- Worktrees em `.kiro/local/wt/<ft>/`; diga aos subagentes como rodar comandos nelas (`git -C …`, `cd … && …`).\n- Lote em `.kiro/local/loop-<data>.md` — atualize após cada fase.\n{{SKILLS_EXTRAS}}\n{{SUBAGENTES}}\n",
  "tools": [
    "read",
    "shell",
    "subagent/sdd2-codificador",
    "subagent/sdd2-pesquisador",
    "subagent/sdd2-revisor",
    "subagent/sdd2-verificador",
    "write"
  ],
  "allowedTools": [
    "read"
  ],
  "resources": [
    "file://.kiro/steering/sdd2.md",
    "file://.kiro/steering/sdd2-projeto.md",
    "skill://{{POWER}}/skills/sdd2-loop/SKILL.md",
    "skill://{{POWER}}/skills/sdd2-iniciar/SKILL.md",
    "skill://{{POWER}}/skills/sdd2-status/SKILL.md"
  ],
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        ".kiro/local/**",
        ".kiro/specs/**"
      ]
    },
    "shell": {
      "allowedCommands": [
        "git status.*",
        "git diff.*",
        "git log.*",
        "git show.*",
        "git grep.*",
        "git ls-files.*",
        "git ls-tree.*",
        "git branch.*",
        "git fetch.*",
        "git worktree add \\.kiro/local/wt/.*",
        "git worktree list.*",
        "git for-each-ref.*",
        "git -C \\.kiro/local/wt/.* status.*",
        "git -C \\.kiro/local/wt/.* diff.*",
        "git -C \\.kiro/local/wt/.* log.*",
        "git -C \\.kiro/local/wt/.* show.*",
        "git -C \\.kiro/local/wt/.* grep.*",
        "git -C \\.kiro/local/wt/.* add .*",
        "git -C \\.kiro/local/wt/.* commit .*",
        "git -C \\.kiro/local/wt/.* fetch.*",
        "ls.*",
        "find .* -name .*",
        "find .* -type .*",
        "grep .*",
        "rg .*",
        "cat .*",
        "head .*",
        "tail .*",
        "wc .*",
        "uuidgen.*"
      ],
      "deniedCommands": [
        ".*push --force.*",
        ".*push -f.*",
        ".*git merge.*",
        ".*git rebase.*",
        ".*git reset --hard.*",
        ".*git clean.*",
        ".*git stash.*",
        ".*worktree remove --force.*",
        ".*worktree remove -f.*",
        ".*rm -rf.*",
        ".*-delete.*",
        ".*-exec rm.*"
      ],
      "autoAllowReadonly": true
    },
    "subagent": {
      "availableAgents": [
        "sdd2-pesquisador",
        "sdd2-codificador",
        "sdd2-revisor",
        "sdd2-verificador"
      ]
    }
  },
  "includeMcpJson": false,
  "welcomeMessage": "Quais fatias AFK devo levar até o PR? (lista de FT-nnn ou \"as prontas da sprint\")",
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "git status*",
          "git diff*",
          "git log*",
          "git show*",
          "git grep*",
          "git ls-files*",
          "git ls-tree*",
          "git branch*",
          "git fetch*",
          "git worktree add .kiro/local/wt/*",
          "git worktree list*",
          "git for-each-ref*",
          "git -C .kiro/local/wt/* status*",
          "git -C .kiro/local/wt/* diff*",
          "git -C .kiro/local/wt/* log*",
          "git -C .kiro/local/wt/* show*",
          "git -C .kiro/local/wt/* grep*",
          "git -C .kiro/local/wt/* add *",
          "git -C .kiro/local/wt/* commit *",
          "git -C .kiro/local/wt/* fetch*",
          "ls*",
          "find * -name *",
          "find * -type *",
          "grep *",
          "rg *",
          "cat *",
          "head *",
          "tail *",
          "wc *",
          "uuidgen*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "*push --force*",
          "*push -f*",
          "*git merge*",
          "*git rebase*",
          "*git reset --hard*",
          "*git clean*",
          "*git stash*",
          "*worktree remove --force*",
          "*worktree remove -f*",
          "*rm -rf*",
          "*-delete*",
          "*-exec rm*"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          ".kiro/local/**",
          ".kiro/specs/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ],
    "policies": [
      "read-only-shell"
    ]
  }
}
